<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.hwbench</groupId>
        <artifactId>HardwareBenchmark-parent</artifactId>
        <version>2.0.0</version>
    </parent>

    <artifactId>HardwareBenchmark-bukkit</artifactId>
    <packaging>jar</packaging>
    <name>HardwareBenchmark Bukkit/Spigot</name>
    <description>Bukkit/Spigot/Paper 端：硬件检测与跑分插件（Multi-Release JAR，兼容 1.7.10~1.21.3 / Java 8~21）</description>

    <dependencies>
        <dependency>
            <groupId>com.hwbench</groupId>
            <artifactId>HardwareBenchmark-common</artifactId>
        </dependency>
        <!-- Spigot API (provided by server) -->
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
            <version>${spigot.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- 单一通用 JAR：覆盖 Bukkit/Spigot/Paper 1.7.10~1.21.3，Java 8/11/17/21 -->
        <finalName>HardwareBenchmark-${project.version}-bukkit-universal</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <encoding>UTF-8</encoding>
                    <excludes>
                        <exclude>**/StandaloneDemo.java</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <!-- 基础编译：Java 8 字节码，输出到 JAR 根目录（所有 JVM 可加载） -->
                    <execution>
                        <id>default-compile</id>
                        <configuration>
                            <release>8</release>
                            <encoding>UTF-8</encoding>
                            <excludes>
                                <exclude>**/StandaloneDemo.java</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                    <!-- Java 17 覆盖层：输出到 META-INF/versions/17/（Java 17+ JVM 加载） -->
                    <execution>
                        <id>compile-java17-overlay</id>
                        <phase>compile</phase>
                        <goals><goal>compile</goal></goals>
                        <configuration>
                            <release>17</release>
                            <encoding>UTF-8</encoding>
                            <compileSourceRoots>
                                <compileSourceRoot>${project.basedir}/src/main/java17</compileSourceRoot>
                            </compileSourceRoots>
                            <multiReleaseOutput>true</multiReleaseOutput>
                        </configuration>
                    </execution>
                    <!-- Java 21 覆盖层：输出到 META-INF/versions/21/（Java 21+ JVM 加载） -->
                    <execution>
                        <id>compile-java21-overlay</id>
                        <phase>compile</phase>
                        <goals><goal>compile</goal></goals>
                        <configuration>
                            <release>21</release>
                            <encoding>UTF-8</encoding>
                            <compileSourceRoots>
                                <compileSourceRoot>${project.basedir}/src/main/java21</compileSourceRoot>
                            </compileSourceRoots>
                            <multiReleaseOutput>true</multiReleaseOutput>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <artifactSet>
                                <includes>
                                    <include>com.hwbench:HardwareBenchmark-common</include>
                                    <include>com.github.oshi:oshi-core</include>
                                    <include>net.java.dev.jna:*</include>
                                    <include>com.google.code.gson:gson</include>
                                    <include>org.slf4j:slf4j-api</include>
                                </includes>
                            </artifactSet>
                            <relocations>
                                <relocation>
                                    <pattern>oshi</pattern>
                                    <shadedPattern>com.hwbench.lib.oshi</shadedPattern>
                                </relocation>
                                <!-- JNA 不重定位：JNA 原生库 libjnidispatch.so 的 JNI 符号为
                                     Java_com_sun_jna_Native_*，重定位类名会导致 UnsatisfiedLinkError -->
                                <relocation>
                                    <pattern>com.google.gson</pattern>
                                    <shadedPattern>com.hwbench.lib.gson</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.slf4j</pattern>
                                    <shadedPattern>com.hwbench.lib.slf4j</shadedPattern>
                                </relocation>
                            </relocations>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <manifestEntries>
                                <Multi-Release>true</Multi-Release>
                            </manifestEntries>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            通用 JAR 说明：
            - 统一使用 mc-1.20.1（默认）编译，base 强制 release 8，覆盖层 17/21 由上方 executions 固定。
            - AsyncPreLoginListener 不再通过 profile 排除；其加载由 HardwareBenchmarkPlugin
              中的 Class.forName 运行时反射守卫（先检测 AsyncPlayerPreLoginEvent 是否存在），
              因此在 1.7.10 上该类存在于 JAR 中但永不被加载。
            - 旧 mc-1.7.10 profile 保留用于选择 spigot-api 1.7.10 依赖，但不再排除任何源文件。
        -->
        <profile>
            <id>mc-1.7.10</id>
            <properties>
                <mc.label>1.7.10</mc.label>
                <mc.short>1.7</mc.short>
                <spigot.version>1.7.10-R0.1-SNAPSHOT</spigot.version>
                <mc.api.version.line></mc.api.version.line>
                <java.release>8</java.release>
            </properties>
        </profile>
    </profiles>
</project>
